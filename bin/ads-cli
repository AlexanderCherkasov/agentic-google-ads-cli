#!/usr/bin/env bash
# Self-Bootstrapping CLI Launcher for Google Ads Automation

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
VENV_DIR="$PROJECT_DIR/venv"
VENV_PYTHON="$VENV_DIR/bin/python"
VENV_PIP="$VENV_DIR/bin/pip"
REQUIREMENTS_FILE="$PROJECT_DIR/requirements.txt"

# 1. Check Python 3 Availability
if ! command -v python3 &> /dev/null; then
    echo "[ERROR] python3 is required but not installed on this system." >&2
    exit 1
fi

# 2. Auto-Create Virtual Environment if missing
if [ ! -d "$VENV_DIR" ] || [ ! -f "$VENV_PYTHON" ]; then
    echo "[+] Initializing Python virtual environment in: $VENV_DIR"
    python3 -m venv "$VENV_DIR"
    echo "[+] Virtual environment created successfully."
fi

# 3. Auto-Install/Sync Requirements if needed
if [ -f "$REQUIREMENTS_FILE" ]; then
    # Check if google-ads package is installed in venv
    if ! "$VENV_PYTHON" -c "import google.ads.googleads; import yaml; import pydantic" &> /dev/null; then
        echo "[+] Installing required Python dependencies from requirements.txt..."
        "$VENV_PIP" install -q --upgrade pip
        "$VENV_PIP" install -q -r "$REQUIREMENTS_FILE"
        echo "[SUCCESS] All Python dependencies installed successfully."
    fi
fi

# 4. Execute the Python CLI entrypoint with all passed arguments
exec "$VENV_PYTHON" "$PROJECT_DIR/scripts/cli.py" "$@"
